{
  "name": "scholarpath-mean-stack",
  "version": "1.0.0",
  "description": "ScholarPath - A MEAN Stack application for scholarship management",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install": "npm install",
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "start:backend": "npm start -w backend",
    "start:frontend": "npm start -w frontend",
    "start": "npm start --workspaces",
    "seed": "node backend/utils/seedData.js"
  },
  "keywords": [
    "scholarship",
    "mean-stack",
    "angular",
    "express",
    "mongodb"
  ],
  "author": "ScholarPath Team",
  "license": "MIT"
}
